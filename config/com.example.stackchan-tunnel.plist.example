<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DRAFT/TODO(owner)：快照里只有 extras/stackchan-tunnel.sh，没有隧道 plist；
     这个模板是按脚本行为起草的，Label 与路径请按你的命名改。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.stackchan-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/StackChan/extras/stackchan-tunnel.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/stackchan-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/stackchan-tunnel.log</string>
</dict>
</plist>
