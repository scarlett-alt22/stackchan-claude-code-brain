# gateway.env.example — Mac 网关 / TTS / Brain 的环境变量模板
# 真实值只放在 launchd plist 或本机 env 里，绝不进 git。
# 变量名来自 gateway/stackchan_gateway.py 与 com.example.stackchan-gateway.plist。

# --- 网关本体 ---
STACKCHAN_GATEWAY_HOST=0.0.0.0
STACKCHAN_GATEWAY_PORT=8124
STACKCHAN_UPSTREAM_URL=https://YOUR_VPS_IP:8443/v1/chat/completions
STACKCHAN_UPSTREAM_CA=$HOME/Library/Application\ Support/StackChanGateway/shim_ca.pem
STACKCHAN_SECRET_CONFIG=$HOME/Library/Application\ Support/StackChanGateway/SC_SecConfig.yaml
STACKCHAN_UPSTREAM_TIMEOUT=30
STACKCHAN_GATEWAY_LOG_LEVEL=INFO

# 设备鉴权：只存 token 的 SHA-256（64 位 hex），不要存明文
STACKCHAN_DEVICE_TOKEN_SHA256=SHA256_OF_YOUR_DEVICE_TOKEN

# --- STT 上游（本地 SenseVoice :8127；用 Whisper 备选就改成 :8126。想换远端也改这里，网关代码零改动）---
STACKCHAN_STT_UPSTREAM_URL=http://127.0.0.1:8127/v1/audio/transcriptions
STACKCHAN_STT_TOKEN_SHA256=SHA256_OF_YOUR_STT_TOKEN
STACKCHAN_STT_TIMEOUT=30

# --- Brain：cc = fork 你的 Claude Code 会话；api = 回落 VPS 透传 ---
STACKCHAN_BRAIN=cc
STACKCHAN_CLAUDE_BIN=/opt/homebrew/bin/claude
STACKCHAN_CC_MODEL=opus
STACKCHAN_CC_TIMEOUT=45
# PATH 必须让 launchd 子进程找到 brew 的 claude：
PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin

# --- TTS 服务（extras/tts_minimax_server.py，:8125）---
TTS_PORT=8125
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY
MINIMAX_VOICE_ID=YOUR_CLONED_VOICE_ID
# 必须设 1：服务端默认不流式（STREAM 默认 0），不设的话首包要等整句合成完
MINIMAX_STREAM=1
# 实际在用的是 turbo；不设时代码默认 speech-2.8-hd
MINIMAX_MODEL=speech-2.8-turbo
# 海外区默认；国内区账号改成国内区的 host
# MINIMAX_HOST=https://api.minimax.io
# MINIMAX_MP3_BITRATE=64000   # 可选，白名单 32000/64000/128000/256000

# --- 回环流量不许走系统代理（大小写两份都要：urllib 认小写，别家认大写）---
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# --- 不常改的（括号里是代码默认值，不设就用默认）---
# STACKCHAN_TTS_UPSTREAM=http://127.0.0.1:8125/v1/audio/speech
# STACKCHAN_PHOTO_DIR=$HOME/StackChan/photos
# STACKCHAN_ROBOT_LOG=$HOME/StackChan/robot-log.jsonl
# STACKCHAN_CLAUDE_CWD=$HOME              # 你的 Claude Code 窗口在哪个目录启动
# STACKCHAN_CLAUDE_PROJECTS_DIR=          # 默认由上一项推出 ~/.claude/projects/<路径里的 / 换成 ->
# STACKCHAN_CC_MAX_AGE_HOURS=72           # 多久没用过的窗口不再当大脑
